#!/usr/bin/env bash
#MISE description="Run the pi-web UI in the pi-less-yolo-web container (project dir only, localhost)"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

# Identity first: _docker_flags turns these into --env/--label/--name flags.
# PI_WEB_INSTANCE (default "main") separates concurrent daemons — each gets its
# own port and data dir, so several pi:web can share one worktree directory.
PI_WEB_INSTANCE="${PI_WEB_INSTANCE:-main}"
PROJECT="$(basename "$(pwd)")"
HASH="$(printf '%s' "$(pwd):${PI_WEB_INSTANCE}" | cksum | cut -d' ' -f1)"
export PI_INSTANCE_ID="web-${PI_WEB_INSTANCE}"
# ply.worktree is the branch name (consistent with _docker_flags default labels);
# fall back to the dir name outside git repos / detached HEAD.
WORKTREE_NAME="$(git branch --show-current 2>/dev/null || true)"
WORKTREE_NAME="${WORKTREE_NAME:-$(basename "$(pwd)")}"
PI_LABELS="ply.project=${PROJECT},ply.worktree=${WORKTREE_NAME},ply.instance=${PI_WEB_INSTANCE}"
export PI_LABELS
export PI_CONTAINER_NAME="ply-web-${PROJECT}-${PI_WEB_INSTANCE}"

# shellcheck source=tasks/pi/_docker_flags
source "$(dirname "$0")/_docker_flags"

# Use the web image, not the CLI image. PI_IMAGE is only referenced by the
# inspect/build check above (harmless: base image exists) and by the run below.
PI_IMAGE="pi-less-yolo-web:latest"
"${DOCKER_CMD}" image inspect "${PI_IMAGE}" > /dev/null 2>&1 || mise run pi:web-build

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

# Deterministic per-(project,instance) port in 8504–8599, overridable.
# Host-side publish is localhost-only; exposure is controlled here, not in the app.
PI_WEB_PORT="${PI_WEB_PORT:-$((8504 + HASH % 96))}"
DOCKER_FLAGS+=("--publish" "127.0.0.1:${PI_WEB_PORT}:8504")

# pi-web config is shared; data dir is per (project, instance) — sessiond
# requires exclusive ownership of its data dir, so concurrent daemons must
# not share one. Pre-create so Docker doesn't root-own them.
DATA_DIR="${HOME}/.local/share/pi-web/$(printf '%s' "$(pwd)" | cksum | cut -d' ' -f1)/${PI_WEB_INSTANCE}"
mkdir -p "${HOME}/.config/pi-web" "${DATA_DIR}"
DOCKER_FLAGS+=(
  "--volume" "${HOME}/.config/pi-web:/home/piuser/.config/pi-web"
  "--volume" "${DATA_DIR}:/home/piuser/.local/share/pi-web"
  "--env" "PI_WEB_HOST=0.0.0.0"
  "--env" "PI_WEB_PORT=8504"
  "--env" "PI_WEB_DATA_DIR=/home/piuser/.local/share/pi-web"
)

echo "pi-web [${PI_WEB_INSTANCE}] UI: http://127.0.0.1:${PI_WEB_PORT} (Ctrl-C stops the container)" >&2

# sessiond owns agent sessions; the web/API process shares its data directory.
"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" \
  bash -c 'pi-web-sessiond & exec pi-web-server'
